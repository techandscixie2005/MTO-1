+    block_a2 = float(sum(np.einsum('nsij,nsij->', block, block) for block in np.array_split(matrix, 31)) / mask_a.sum())
+    assert abs(moment_e2 - s_e2) < 1e-11 and abs(block_a2 - s_a2) < 1e-12
+    normalization = {
