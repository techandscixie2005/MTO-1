+    assert np.array_equal(raw_ids, ids[selected])
+    assert energy.shape == (96284, 10) and matrix.shape == (96284, 10, 3, 3)
+    assert mask_e.all() and mask_a.all(), 'Frozen source expects all valid E/A; no implicit exclusion'
